{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Mini Football Booking",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/MiniFootballBooking/bin/Debug/net8.0/MiniFootballBooking.dll",
      "cwd": "${workspaceFolder}/MiniFootballBooking",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  ]
}
